# 换行符规范化：仓库里一律存 LF，检出到工作区时按平台自动转换
# 这样无论谁在什么系统上 clone，提交进仓库的都是同一种换行符
* text=auto

# 明确标出文本文件，方便 diff 和换行符处理
*.py   text
*.md   text
*.txt  text
*.json text
*.toml text
*.cfg  text
*.ini  text
*.yml  text
*.yaml text

# Windows 脚本必须用 CRLF，否则可能执行异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.zip  binary
